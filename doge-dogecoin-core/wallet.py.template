"""Watch-only Dogecoin wallet backend for the Umbrel dashboard (stdlib only).

Security model
--------------
* The node's wallet.dat only ever receives *watch-only* addresses derived
  from a Trezor account xpub (importmulti with watchonly=true). No private
  key is ever generated, imported, derived or stored by this code.
* Spending: this module builds an unsigned transaction from the node's own
  UTXO set and returns everything a Trezor needs to sign it (inputs with
  BIP44 paths, outputs, and the referenced previous transactions pulled from
  the local node). The signed hex comes back and is broadcast by the local
  node. Trezor's servers never learn which addresses belong to this wallet.
* Every mutating endpoint requires a same-origin request with a custom
  header, so a malicious web page in the same browser cannot drive it.
"""

import json
import os
import threading
import time
from decimal import Decimal, ROUND_DOWN

import walletkeys as wk

STATE_DIR = os.environ.get("STATE_DIR", "/state")
STATE_FILE = os.path.join(STATE_DIR, "account.json")
LABEL = "trezor-watchonly"
GAP_LIMIT = 20
KOINU = Decimal("100000000")
DUST = Decimal("0.01")                 # Dogecoin Core 1.14.x dust threshold
DEFAULT_FEE_PER_KB = Decimal("0.01")   # recommended fee rate, DOGE/kB
MIN_FEE_PER_KB = Decimal("0.001")      # minimum relay fee, DOGE/kB
MAX_FEE_PER_KB = Decimal("10")

_lock = threading.Lock()
_rescan = {"running": False, "started": 0, "error": None}


class WalletError(Exception):
    pass


def _q(d):
    """Exact 8-decimal Decimal. Floats from JSON-RPC go through str() so
    89.99 stays 89.99 instead of its binary expansion."""
    if isinstance(d, float):
        d = repr(d)
    return Decimal(d).quantize(Decimal("0.00000001"), rounding=ROUND_DOWN)


def _s(d):
    """Fixed 8-decimal string, never scientific notation."""
    return "{:.8f}".format(_q(d))


def _koinu(d):
    return str(int((_q(d) * KOINU).to_integral_value(ROUND_DOWN)))


# --- state ---------------------------------------------------------------

def load_state():
    try:
        with open(STATE_FILE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def save_state(state):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(state, fh, indent=1)
    os.replace(tmp, STATE_FILE)


def _addr_map(state):
    """address -> (change, index)."""
    out = {}
    for change in (0, 1):
        for i, a in enumerate(state["addresses"][str(change)]):
            out[a] = (change, i)
    return out


# --- import / derivation -------------------------------------------------

def _derive_batch(xpub, change, start, count):
    chain = xpub.derive(change)
    out = []
    for i in range(start, start + count):
        out.append(chain.derive(i).address())
    return out


def _import_addresses(rpc, addrs, timestamp, rescan):
    if not addrs:
        return
    reqs = [
        {"scriptPubKey": {"address": a}, "timestamp": timestamp, "watchonly": True, "label": LABEL}
        for a in addrs
    ]
    res = rpc("importmulti", [reqs, {"rescan": rescan}], timeout=None if rescan else 60)
    bad = [r for r in res if not r.get("success")]
    if bad:
        raise WalletError("importmulti failed: " + json.dumps(bad[0].get("error", {}))[:200])


def start_import(rpc, xpub_str, account_index, since_ts):
    """Import the first GAP_LIMIT receive+change addresses. Rescan runs in
    the background when a start date is given, because a rescan of the
    Dogecoin chain can take hours."""
    with _lock:
        if _rescan["running"]:
            raise WalletError("A rescan is already running")
        if load_state():
            raise WalletError("An account is already imported. Forget it first.")
        try:
            xpub = wk.Xpub(xpub_str.strip())
        except ValueError as exc:
            raise WalletError("Invalid xpub: " + str(exc))
        if not (0 <= int(account_index) < 0x80000000):
            raise WalletError("Account number out of range")
        if xpub.depth != 3:
            raise WalletError(
                "This key is at depth " + str(xpub.depth) + ", not an account key. "
                "Export the account-level public key (m/44'/3'/" + str(account_index) + "') from Trezor Suite."
            )
        state = {
            "xpub": xpub.serialize(),
            "fingerprint": xpub.own_fingerprint().hex(),
            "account": int(account_index),
            "since": since_ts,
            "created": int(time.time()),
            "addresses": {"0": _derive_batch(xpub, 0, 0, GAP_LIMIT), "1": _derive_batch(xpub, 1, 0, GAP_LIMIT)},
        }
        rescan = bool(since_ts)
        timestamp = int(since_ts) if since_ts else "now"
        all_addrs = state["addresses"]["0"] + state["addresses"]["1"]
        if not rescan:
            _import_addresses(rpc, all_addrs, timestamp, False)
            save_state(state)
            return {"rescan": False}
        _rescan.update(running=True, started=time.time(), error=None)

    def job():
        try:
            _import_addresses(rpc, all_addrs, timestamp, True)
            save_state(state)
            extend_gap(rpc)
        except Exception as exc:  # noqa: BLE001
            _rescan["error"] = "Import failed, account not linked: " + str(exc)
        finally:
            _rescan["running"] = False

    threading.Thread(target=job, daemon=True).start()
    return {"rescan": True}


def forget(rpc):
    """Forget the account. The watch-only addresses stay in wallet.dat
    (Dogecoin Core 1.14 cannot remove them) but the UI stops using them."""
    with _lock:
        if _rescan["running"]:
            raise WalletError("Wait for the rescan to finish")
        try:
            os.remove(STATE_FILE)
        except OSError:
            pass


def _used_addresses(rpc):
    rows = rpc("listreceivedbyaddress", [0, True, True])
    return {r["address"] for r in rows if r.get("txids")}


def extend_gap(rpc):
    """Make sure GAP_LIMIT unused addresses exist after the last used one on
    each chain, importing new ones (no rescan: they cannot have history
    before now that the earlier ones didn't reveal)."""
    with _lock:
        state = load_state()
        if not state or _rescan["running"]:
            return
        used = _used_addresses(rpc)
        xpub = wk.Xpub(state["xpub"])
        changed = False
        for change in (0, 1):
            lst = state["addresses"][str(change)]
            last_used = max((i for i, a in enumerate(lst) if a in used), default=-1)
            need = last_used + 1 + GAP_LIMIT - len(lst)
            if need > 0:
                new = _derive_batch(xpub, change, len(lst), need)
                _import_addresses(rpc, new, "now", False)
                lst.extend(new)
                changed = True
        if changed:
            save_state(state)


# --- read side -----------------------------------------------------------

def _our_utxos(rpc, state):
    amap = _addr_map(state)
    utxos = []
    for u in rpc("listunspent", [0, 9999999, list(amap.keys())]):
        if u.get("address") not in amap:
            continue
        if u.get("spendable"):
            # Should be impossible: it would mean a private key is on the node.
            continue
        change, idx = amap[u["address"]]
        utxos.append({
            "txid": u["txid"], "vout": u["vout"], "address": u["address"],
            "amount": _s(u["amount"]), "confirmations": u.get("confirmations", 0),
            "change": change, "index": idx,
        })
    return utxos


def status(rpc):
    state = load_state()
    out = {
        "imported": bool(state),
        "rescan": {"running": _rescan["running"], "started": _rescan["started"], "error": _rescan["error"]},
        "gap_limit": GAP_LIMIT,
        "fee": {"default_per_kb": str(DEFAULT_FEE_PER_KB), "min_per_kb": str(MIN_FEE_PER_KB), "dust": str(DUST)},
    }
    out["node"] = node_status(rpc)
    out["mydoge"] = mydoge_status(rpc)
    if not state:
        return out
    xp = wk.Xpub(state["xpub"])
    out["account"] = {"fingerprint": state["fingerprint"], "index": state["account"], "since": state["since"],
                      "xpub": state["xpub"], "xpub_forms": [xp.serialize(v) for v in wk.XPUB_VERSIONS],
                      "receive_count": len(state["addresses"]["0"]), "change_count": len(state["addresses"]["1"])}
    if _rescan["running"]:
        return out
    try:
        extend_gap(rpc)
        state = load_state()
        utxos = _our_utxos(rpc, state)
        conf = sum(Decimal(u["amount"]) for u in utxos if u["confirmations"] > 0)
        unconf = sum(Decimal(u["amount"]) for u in utxos if u["confirmations"] == 0)
        out["balance"] = {"confirmed": _s(conf), "unconfirmed": _s(unconf)}
        out["utxos"] = utxos
        out["receive"] = next_receive(rpc, state)
        out["transactions"] = _history(rpc, state)
    except WalletError as exc:
        out["error"] = str(exc)
    return out


def next_receive(rpc, state=None):
    state = state or load_state()
    if not state:
        raise WalletError("No account imported")
    used = _used_addresses(rpc)
    for i, a in enumerate(state["addresses"]["0"]):
        if a not in used:
            return {"address": a, "index": i, "path": "m/44'/3'/" + str(state["account"]) + "'/0/" + str(i),
                    "address_n": wk.bip44_path(state["account"], 0, i)}
    raise WalletError("No unused receive address (gap limit); refresh and try again")


def _history(rpc, state):
    amap = _addr_map(state)
    rows = rpc("listtransactions", ["*", 200, 0, True])
    by_txid = {}
    for r in rows:
        cat = r.get("category")
        if cat == "receive" and r.get("address") not in amap:
            continue
        if cat == "send" and not r.get("involvesWatchonly"):
            continue  # a node-wallet spend, not this account's
        if cat not in ("receive", "send"):
            continue
        t = by_txid.setdefault(r["txid"], {"txid": r["txid"], "time": r.get("time"), "confirmations": r.get("confirmations", 0),
                                           "received": Decimal(0), "sent": Decimal(0), "fee": Decimal(0)})
        amt = _q(r.get("amount", 0))
        if cat == "receive":
            t["received"] += amt
        else:
            t["sent"] += -amt
            if r.get("fee") is not None:
                t["fee"] = -_q(r["fee"])
    out = []
    for t in sorted(by_txid.values(), key=lambda t: (t["time"] or 0), reverse=True):
        net = t["received"] - t["sent"]
        out.append({"txid": t["txid"], "time": t["time"], "confirmations": t["confirmations"],
                    "net": _s(net), "fee": _s(t["fee"])})
    return out


# --- send side -----------------------------------------------------------

def _estimate_size(n_in, n_out):
    return 10 + 148 * n_in + 34 * n_out


def _ref_tx(rpc, txid):
    """Previous transaction in the shape Trezor Connect expects, fetched
    from the local node (the UTXO belongs to the wallet so gettransaction
    works without -txindex)."""
    try:
        hexstr = rpc("gettransaction", [txid, True])["hex"]
    except Exception as exc:  # noqa: BLE001
        raise WalletError("Cannot load previous transaction " + txid + ": " + str(exc))
    d = rpc("decoderawtransaction", [hexstr])
    return {
        "hash": d["txid"],
        "version": d["version"],
        "lock_time": d["locktime"],
        "inputs": [
            {"prev_hash": v["txid"], "prev_index": v["vout"], "script_sig": v["scriptSig"]["hex"], "sequence": v["sequence"]}
            for v in d["vin"]
        ],
        "bin_outputs": [
            {"amount": _koinu(o["value"]), "script_pubkey": o["scriptPubKey"]["hex"]} for o in d["vout"]
        ],
    }


def build(rpc, to_address, amount, fee_per_kb=None, subtract_fee=False, send_max=False, source="trezor"):
    if source not in ("trezor", "node", "mydoge"):
        raise WalletError("Unknown signing source")
    state = load_state()
    md = None
    if source == "mydoge":
        md = _mydoge_cfg()
        if not md:
            raise WalletError("No MyDoge wallet connected")
        if _rescan["running"]:
            raise WalletError("Rescan still running")
    if source == "trezor":
        if not state:
            raise WalletError("No Trezor account imported")
        if _rescan["running"]:
            raise WalletError("Rescan still running")
    elif source == "node":
        ns = node_status(rpc)
        if not ns.get("enabled"):
            raise WalletError("Node wallet mode is not enabled")
        if not ns.get("encrypted"):
            raise WalletError("Node wallet is not encrypted")
    to_address = (to_address or "").strip()
    try:
        wk.validate_doge_address(to_address)
    except ValueError as exc:
        raise WalletError("Recipient is not a valid Dogecoin address (" + str(exc) + ")")
    try:
        fee_per_kb = _q(Decimal(str(fee_per_kb))) if fee_per_kb not in (None, "") else DEFAULT_FEE_PER_KB
    except Exception:  # noqa: BLE001
        raise WalletError("Invalid fee rate")
    if not (MIN_FEE_PER_KB <= fee_per_kb <= MAX_FEE_PER_KB):
        raise WalletError("Fee rate must be between " + str(MIN_FEE_PER_KB) + " and " + str(MAX_FEE_PER_KB) + " DOGE/kB")

    if source == "trezor":
        utxos = [u for u in _our_utxos(rpc, state) if u["confirmations"] > 0]
    elif source == "mydoge":
        utxos = [u for u in _mydoge_utxos(rpc, md) if u["confirmations"] > 0]
    else:
        utxos = [u for u in _node_utxos(rpc) if u["confirmations"] > 0]
    if not utxos:
        raise WalletError("No confirmed coins to spend")
    utxos.sort(key=lambda u: Decimal(u["amount"]), reverse=True)
    total_avail = sum(Decimal(u["amount"]) for u in utxos)

    if send_max:
        chosen = utxos
        fee = _q(fee_per_kb * _estimate_size(len(chosen), 1) / 1000)
        amount = total_avail - fee
        if amount <= DUST:
            raise WalletError("Balance too small to send after fee")
        change = Decimal(0)
    else:
        try:
            amount = _q(Decimal(str(amount)))
        except Exception:  # noqa: BLE001
            raise WalletError("Invalid amount")
        if amount < DUST:
            raise WalletError("Amount is below the dust limit of " + str(DUST) + " DOGE")
        chosen, acc = [], Decimal(0)
        fee = Decimal(0)
        for u in utxos:
            chosen.append(u)
            acc += Decimal(u["amount"])
            fee = _q(fee_per_kb * _estimate_size(len(chosen), 2) / 1000)
            target = amount if subtract_fee else amount + fee
            if acc >= target:
                break
        target = amount if subtract_fee else amount + fee
        if acc < target:
            raise WalletError("Insufficient confirmed balance: have " + _s(total_avail) + ", need " + _s(target) + " incl. fee")
        if subtract_fee:
            amount = amount - fee
            if amount <= DUST:
                raise WalletError("Amount after subtracting the fee is below dust")
            change = acc - amount - fee
        else:
            change = acc - amount - fee
        if change < DUST:
            # Change would be dust: add it to the fee instead.
            fee += change
            change = Decimal(0)
    if fee > Decimal("100") and fee > amount:
        raise WalletError("Refusing an absurdly high fee (" + str(fee) + " DOGE)")

    if source == "mydoge" and to_address == md["address"]:
        raise WalletError("Sending to the MyDoge address itself would only pay a fee; nothing to do")
    if source == "trezor" and to_address in _addr_map(state):
        raise WalletError("Recipient is one of this account's own addresses; sending to yourself only pays a fee")
    outputs = [{"address": to_address, "amount": _koinu(amount), "script_type": "PAYTOADDRESS"}]
    rpc_outputs = {to_address: _s(amount)}
    change_info = None
    if change > 0 and source in ("node", "mydoge"):
        caddr = rpc("getrawchangeaddress") if source == "node" else md["address"]
        change_info = {"address": caddr, "index": None, "amount": _s(change)}
        outputs.append({"address": caddr, "amount": _koinu(change), "script_type": "PAYTOADDRESS"})
        rpc_outputs[caddr] = _s(change)
    elif change > 0:
        used = _used_addresses(rpc)
        cidx = next((i for i, a in enumerate(state["addresses"]["1"]) if a not in used), None)
        if cidx is None:
            raise WalletError("No unused change address; refresh and try again")
        caddr = state["addresses"]["1"][cidx]
        change_info = {"address": caddr, "index": cidx, "amount": _s(change)}
        outputs.append({"address_n": wk.bip44_path(state["account"], 1, cidx), "amount": _koinu(change), "script_type": "PAYTOADDRESS"})
        rpc_outputs[caddr] = _s(change)

    inputs = []
    ref_txs = {}
    for u in chosen:
        inp = {"prev_hash": u["txid"], "prev_index": u["vout"], "amount": _koinu(u["amount"]),
               "script_type": "SPENDADDRESS", "address": u["address"]}
        if source == "trezor":
            inp["address_n"] = wk.bip44_path(state["account"], u["change"], u["index"])
            if u["txid"] not in ref_txs:
                ref_txs[u["txid"]] = _ref_tx(rpc, u["txid"])
        inputs.append(inp)

    if len(rpc_outputs) != len(outputs):
        raise WalletError("Recipient collides with the change address; refusing to build")
    unsigned = rpc("createrawtransaction", [[{"txid": u["txid"], "vout": u["vout"]} for u in chosen], rpc_outputs])
    _remember_build(source, chosen, to_address, amount, change_info, unsigned)
    return {
        "coin": "Dogecoin",
        "source": source,
        "inputs": inputs,
        "outputs": outputs,
        "refTxs": list(ref_txs.values()),
        "to": to_address,
        "amount": _s(amount),
        "fee": _s(fee),
        "fee_per_kb": str(fee_per_kb),
        "change": change_info,
        "unsigned_hex": unsigned,
        "size_estimate": _estimate_size(len(chosen), len(outputs)),
    }


# Server-side memory of what was built, so a signed transaction can be
# verified here rather than only in the browser (claim 3). Keyed by the
# exact input set; kept for an hour.
_builds = {}
BUILD_TTL = 3600


def _inputs_key(ins):
    return tuple(sorted((i["txid"], int(i["vout"])) for i in ins))


def _remember_build(source, chosen, to_address, amount, change_info, unsigned):
    now = time.time()
    for k in [k for k, b in _builds.items() if now - b["t"] > BUILD_TTL]:
        del _builds[k]
    expected = {to_address: _s(amount)}
    if change_info:
        expected[change_info["address"]] = change_info["amount"]
    _builds[_inputs_key(chosen)] = {"t": now, "source": source, "outputs": expected, "unsigned": unsigned}


def verify_against_build(rpc, hexstr):
    """Return the remembered build this signed tx matches, else raise."""
    info = decode(rpc, hexstr)
    key = _inputs_key(info["inputs"])
    b = _builds.get(key)
    if not b:
        raise WalletError("This transaction does not match anything built on this page (inputs differ or the build expired)")
    got = {}
    for o in info["outputs"]:
        if o.get("type") != "pubkeyhash" or not o.get("address"):
            raise WalletError("Signed transaction contains a non-standard output; refusing")
        if o["address"] in got:
            raise WalletError("Signed transaction pays the same address twice; refusing")
        got[o["address"]] = o["value"]
    if got != b["outputs"]:
        raise WalletError("Signed transaction outputs differ from the reviewed transaction; refusing to broadcast")
    return b, info


def decode(rpc, hexstr):
    hexstr = (hexstr or "").strip()
    if not hexstr or any(c not in "0123456789abcdefABCDEF" for c in hexstr):
        raise WalletError("Not a hex transaction")
    try:
        d = rpc("decoderawtransaction", [hexstr])
    except Exception as exc:  # noqa: BLE001
        raise WalletError("Cannot decode: " + str(exc))
    state = load_state()
    amap = _addr_map(state) if state else {}
    md = _mydoge_cfg()
    if md:
        amap = dict(amap)
        amap[md["address"]] = ("mydoge", 0)
    outs = []
    if len(d["vout"]) > 200:
        raise WalletError("Too many outputs")
    for o in d["vout"]:
        spk = o.get("scriptPubKey", {})
        addrs = spk.get("addresses", [])
        # Only a plain single-address P2PKH output can be "mine": a bare
        # multisig would list our key alongside an attacker's.
        addr = addrs[0] if (spk.get("type") == "pubkeyhash" and len(addrs) == 1) else None
        mine = bool(addr and addr in amap)
        if addr and not mine:
            try:
                v = rpc("validateaddress", [addr])
                mine = bool(v.get("ismine")) and not v.get("iswatchonly")
            except Exception:  # noqa: BLE001
                mine = False
        outs.append({"n": o["n"], "value": _s(o["value"]), "address": addr, "type": spk.get("type"), "mine": mine})
    signed = all(v.get("scriptSig", {}).get("hex") for v in d["vin"])
    return {"txid": d["txid"], "size": d.get("size"), "signed": signed,
            "inputs": [{"txid": v["txid"], "vout": v["vout"]} for v in d["vin"]], "outputs": outs}


def broadcast(rpc, hexstr, unverified=False):
    info = decode(rpc, hexstr)
    if not info["signed"]:
        raise WalletError("This transaction is not signed")
    if not unverified:
        verify_against_build(rpc, hexstr)
    try:
        txid = rpc("sendrawtransaction", [hexstr.strip()])
    except Exception as exc:  # noqa: BLE001
        raise WalletError("Node rejected the transaction: " + str(exc))
    return {"txid": txid}


# --- node wallet (keys in the node's encrypted wallet.dat) -------------------
#
# Second signing source. Opt-in, and only usable once wallet.dat is
# encrypted. The passphrase is never stored: it is sent with the sign
# request, the wallet is unlocked for a few seconds, the node signs with
# signrawtransaction, and the wallet is locked again in a finally block.

NODE_FILE = os.path.join(STATE_DIR, "node.json")
NODE_LABEL = "nodewallet"
UNLOCK_SECONDS = 5
_sign_lock = threading.Lock()


def _node_cfg():
    try:
        with open(NODE_FILE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {"enabled": False}


def _save_node_cfg(cfg):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = NODE_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(cfg, fh)
    os.replace(tmp, NODE_FILE)


def node_status(rpc):
    cfg = _node_cfg()
    out = {"enabled": bool(cfg.get("enabled")), "encrypted": None, "unlocked": False}
    try:
        info = rpc("getwalletinfo")
    except Exception as exc:  # noqa: BLE001
        out["error"] = "node unavailable: " + str(exc)
        return out
    out["encrypted"] = "unlocked_until" in info
    out["unlocked"] = bool(info.get("unlocked_until", 0))
    if cfg.get("pending_enable") and out["encrypted"]:
        cfg = {"enabled": True, "since": cfg.get("since")}
        _save_node_cfg(cfg)
        out["enabled"] = True
    bal = _q(info.get("balance", 0))
    unconf = _q(info.get("unconfirmed_balance", 0))
    out["balance"] = {"confirmed": _s(bal), "unconfirmed": _s(unconf)}
    out["keypool"] = info.get("keypoolsize")
    # Spendable funds in a wallet the user has not opted into => warn.
    out["hot_balance_warning"] = (bal + unconf) > 0 and not out["enabled"]
    if out["enabled"] and out["encrypted"]:
        try:
            out["receive"] = node_receive(rpc)
            out["transactions"] = _node_history(rpc)
            out["utxos"] = _node_utxos(rpc)
        except WalletError as exc:
            out["error"] = str(exc)
    return out


def _node_utxos(rpc):
    utxos = []
    for u in rpc("listunspent", [0, 9999999]):
        if not u.get("spendable"):
            continue
        utxos.append({"txid": u["txid"], "vout": u["vout"], "address": u.get("address"),
                      "amount": _s(u["amount"]), "confirmations": u.get("confirmations", 0),
                      "change": None, "index": None})
    return utxos


def _node_history(rpc):
    rows = rpc("listtransactions", ["*", 200, 0, False])
    by_txid = {}
    for r in rows:
        if r.get("involvesWatchonly"):
            continue
        t = by_txid.setdefault(r["txid"], {"txid": r["txid"], "time": r.get("time"), "confirmations": r.get("confirmations", 0),
                                           "received": Decimal(0), "sent": Decimal(0), "fee": Decimal(0)})
        amt = _q(r.get("amount", 0))
        if r.get("category") == "receive":
            t["received"] += amt
        elif r.get("category") == "send":
            t["sent"] += -amt
            if r.get("fee") is not None:
                t["fee"] = -_q(r["fee"])
    return [{"txid": t["txid"], "time": t["time"], "confirmations": t["confirmations"],
             "net": _s(t["received"] - t["sent"]), "fee": _s(t["fee"])}
            for t in sorted(by_txid.values(), key=lambda t: (t["time"] or 0), reverse=True)]


def node_receive(rpc, mint=False):
    """Return an unused labelled address; mint a new one only when asked
    (POST), never from a status poll."""
    try:
        for a in rpc("getaddressesbyaccount", [NODE_LABEL]):
            if not rpc("getreceivedbyaddress", [a, 0]):
                return {"address": a, "path": "node wallet"}
    except Exception:  # noqa: BLE001
        pass
    if not mint:
        return None
    try:
        return {"address": rpc("getnewaddress", [NODE_LABEL]), "path": "node wallet"}
    except Exception as exc:  # noqa: BLE001
        raise WalletError("Cannot create a new address (" + str(exc) + "). Sign one transaction to refill the keypool, or restart the node.")


def _check_passphrase(p):
    if not isinstance(p, str) or len(p) < 10:
        raise WalletError("Passphrase must be at least 10 characters")
    if len(p) > 1024:
        raise WalletError("Passphrase too long")


def node_enable(rpc):
    ns = node_status(rpc)
    if not ns.get("encrypted"):
        raise WalletError("Encrypt the node wallet first")
    _save_node_cfg({"enabled": True, "since": int(time.time())})


def node_disable(rpc):
    _save_node_cfg({"enabled": False})


def node_encrypt(rpc, passphrase, confirm):
    """encryptwallet: Dogecoin Core 1.14 stops the daemon afterwards and
    docker restarts it. The UI shows the node as restarting."""
    ns = node_status(rpc)
    if ns.get("encrypted"):
        raise WalletError("Wallet is already encrypted")
    _check_passphrase(passphrase)
    if passphrase != confirm:
        raise WalletError("Passphrases do not match")
    try:
        rpc("encryptwallet", [passphrase], timeout=120)
    except Exception as exc:  # noqa: BLE001
        msg = str(exc)
        if "already encrypted" in msg or "unlocked_until" in msg:
            raise WalletError("Wallet is already encrypted")
        # The daemon exits during this call; a dropped connection is expected.
    # Mode is switched on by node_status once the restarted node reports an
    # encrypted wallet, not here.
    _save_node_cfg({"enabled": False, "pending_enable": True, "since": int(time.time())})
    return {"restarting": True}


def node_sign(rpc, unsigned_hex, passphrase):
    ns = node_status(rpc)
    if not ns.get("enabled"):
        raise WalletError("Node wallet mode is not enabled")
    if not ns.get("encrypted"):
        raise WalletError("Node wallet is not encrypted; refusing to sign")
    if not isinstance(passphrase, str) or not passphrase:
        raise WalletError("Passphrase required")
    unsigned_hex = (unsigned_hex or "").strip()
    if not unsigned_hex or any(c not in "0123456789abcdefABCDEF" for c in unsigned_hex):
        raise WalletError("Not a hex transaction")
    # Only sign something this page built and the user reviewed.
    if not any(b["unsigned"] == unsigned_hex and b["source"] == "node" for b in _builds.values()):
        raise WalletError("The node only signs transactions built and reviewed on this page")
    if not _sign_lock.acquire(timeout=10):
        raise WalletError("Another signing operation is in progress")
    try:
        try:
            rpc("walletpassphrase", [passphrase, UNLOCK_SECONDS])
        except Exception as exc:  # noqa: BLE001
            raise WalletError("Wrong passphrase" if "incorrect" in str(exc).lower() else "Unlock failed: " + str(exc))
        try:
            res = rpc("signrawtransaction", [unsigned_hex], timeout=UNLOCK_SECONDS)
        except Exception as exc:  # noqa: BLE001
            raise WalletError("Signing failed: " + str(exc))
        finally:
            try:
                rpc("walletlock")
                if rpc("getwalletinfo").get("unlocked_until", 0):
                    rpc("walletlock")
            except Exception:  # noqa: BLE001
                pass
    finally:
        _sign_lock.release()
    if not res.get("complete"):
        raise WalletError("Node could not fully sign this transaction (inputs not owned by the node wallet?)")
    return {"hex": res["hex"]}


def node_backup(rpc):
    """backupwallet writes inside the dogecoind container; the web container
    sees the same directory read-only at /backups for download."""
    ns = node_status(rpc)
    if not ns.get("encrypted"):
        raise WalletError("Refusing to back up an unencrypted wallet: it would contain plaintext keys")
    if not ns.get("enabled"):
        raise WalletError("Node wallet mode is not enabled")
    name = "wallet-" + time.strftime("%Y%m%d-%H%M%S") + ".dat"
    try:
        rpc("backupwallet", ["/data/backups/" + name])
    except Exception as exc:  # noqa: BLE001
        raise WalletError("Backup failed: " + str(exc))
    return {"file": name}


def backup_path(rpc, name):
    if not name or "/" in name or "\\" in name or ".." in name or not name.startswith("wallet-") or not name.endswith(".dat"):
        raise WalletError("bad backup name")
    if "unlocked_until" not in rpc("getwalletinfo"):
        raise WalletError("Refusing to serve a backup while the wallet is unencrypted")
    path = os.path.join(os.environ.get("BACKUP_DIR", "/backups"), name)
    if not os.path.isfile(path):
        raise WalletError("backup not found")
    return path


# --- MyDoge browser extension (third signing source) --------------------------
#
# The extension (window.doge) holds the keys in the user's browser. This node
# watches the connected address (watch-only import), builds spends from its
# own UTXO data, hands the raw tx to the extension's requestPsbt(signOnly)
# and broadcasts the signed result itself.

MYDOGE_FILE = os.path.join(STATE_DIR, "mydoge.json")
MYDOGE_LABEL = "mydoge-watchonly"
MYDOGE_EPOCH = 1672531200  # 2023-01-01: before the extension existed


def _mydoge_cfg():
    try:
        with open(MYDOGE_FILE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def mydoge_connect(rpc, address, pubkey, since_ts=None):
    """Called after window.doge.connect(): verify the public key really
    hashes to the address, then watch it. Rescans in the background."""
    address = (address or "").strip()
    pubkey = (pubkey or "").strip().lower()
    try:
        kind, h160 = wk.validate_doge_address(address)
    except ValueError as exc:
        raise WalletError("MyDoge returned an invalid address (" + str(exc) + ")")
    if kind != "p2pkh":
        raise WalletError("MyDoge address is not P2PKH")
    if not pubkey:
        raise WalletError("MyDoge did not provide a public key; cannot prove ownership of the address")
    try:
        pk = bytes.fromhex(pubkey)
    except ValueError:
        raise WalletError("MyDoge returned a malformed public key")
    if len(pk) not in (33, 65) or wk.hash160(pk) != h160:
        raise WalletError("MyDoge public key does not match its address; refusing")
    with _lock:
        if _rescan["running"]:
            raise WalletError("A rescan is already running")
        old = _mydoge_cfg()
        if old and old["address"] == address:
            return {"rescan": False, "already": True}
        cfg = {"address": address, "pubkey": pubkey, "since": int(since_ts or MYDOGE_EPOCH), "created": int(time.time())}
        _rescan.update(running=True, started=time.time(), error=None)

    def job():
        try:
            reqs = [{"scriptPubKey": {"address": address}, "timestamp": cfg["since"], "watchonly": True, "label": MYDOGE_LABEL}]
            res = rpc("importmulti", [reqs, {"rescan": True}], timeout=None)
            if not res or not res[0].get("success"):
                _rescan["error"] = "MyDoge import failed: " + json.dumps((res or [{}])[0].get("error", {}))[:200]
                return
            os.makedirs(STATE_DIR, exist_ok=True)
            tmp = MYDOGE_FILE + ".tmp"
            with open(tmp, "w") as fh:
                json.dump(cfg, fh)
            os.replace(tmp, MYDOGE_FILE)
        except Exception as exc:  # noqa: BLE001
            _rescan["error"] = "MyDoge import failed: " + str(exc)
        finally:
            _rescan["running"] = False

    threading.Thread(target=job, daemon=True).start()
    return {"rescan": True}


def mydoge_forget():
    with _lock:
        if _rescan["running"]:
            raise WalletError("Wait for the rescan to finish")
        try:
            os.remove(MYDOGE_FILE)
        except OSError:
            pass


def _mydoge_utxos(rpc, md):
    utxos = []
    for u in rpc("listunspent", [0, 9999999, [md["address"]]]):
        if u.get("address") != md["address"] or u.get("spendable"):
            continue
        utxos.append({"txid": u["txid"], "vout": u["vout"], "address": u["address"],
                      "amount": _s(u["amount"]), "confirmations": u.get("confirmations", 0),
                      "change": None, "index": None})
    return utxos


def mydoge_status(rpc):
    md = _mydoge_cfg()
    if not md:
        return {"connected": False}
    out = {"connected": True, "address": md["address"], "pubkey": md.get("pubkey"), "since": md["since"]}
    if _rescan["running"]:
        return out
    try:
        utxos = _mydoge_utxos(rpc, md)
        out["balance"] = {"confirmed": _s(sum(Decimal(u["amount"]) for u in utxos if u["confirmations"] > 0)),
                          "unconfirmed": _s(sum(Decimal(u["amount"]) for u in utxos if u["confirmations"] == 0))}
        out["utxos"] = utxos
        rows = rpc("listtransactions", ["*", 200, 0, True])
        by = {}
        for r in rows:
            cat = r.get("category")
            if cat == "receive" and r.get("address") != md["address"]:
                continue
            if cat == "send" and not r.get("involvesWatchonly"):
                continue
            if cat not in ("receive", "send"):
                continue
            t = by.setdefault(r["txid"], {"txid": r["txid"], "time": r.get("time"), "confirmations": r.get("confirmations", 0),
                                          "received": Decimal(0), "sent": Decimal(0), "fee": Decimal(0)})
            amt = _q(r.get("amount", 0))
            if cat == "receive":
                t["received"] += amt
            else:
                t["sent"] += -amt
        out["transactions"] = [{"txid": t["txid"], "time": t["time"], "confirmations": t["confirmations"],
                                "net": _s(t["received"] - t["sent"]), "fee": "0.00000000"}
                               for t in sorted(by.values(), key=lambda t: (t["time"] or 0), reverse=True)]
    except Exception as exc:  # noqa: BLE001
        out["error"] = str(exc)
    return out
